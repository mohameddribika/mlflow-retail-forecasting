# Dockerfile for the model serving container.
#
# Builds an image with MLflow + scikit-learn + xgboost so that
# `mlflow models serve --model-uri models:/<name>/Production` can load
# and serve the registered model.
#
# The image is generic — the actual model URI is supplied via the
# command in docker-compose.yml. This means swapping the registered
# model name doesn't require rebuilding the image.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# libgomp1 is the OpenMP runtime XGBoost needs at inference time.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 && \
    rm -rf /var/lib/apt/lists/*

# Versions match the local venv's requirements.txt for reproducibility.
RUN pip install --no-cache-dir \
    mlflow==2.18.0 \
    scikit-learn==1.5.2 \
    xgboost==2.1.3 \
    pandas==2.2.3 \
    numpy==1.26.4 \
    psycopg2-binary==2.9.10

EXPOSE 5001

# The actual `mlflow models serve ...` command is in docker-compose.yml.
